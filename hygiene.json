{
  "schema_version": 1,
  "checks": [
    {
      "id": "scaffold",
      "command": [
        "python3",
        "tools/check_scaffold.py"
      ],
      "required_files": [
        "tools/check_scaffold.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "static-quality",
      "command": [
        "python3",
        "tools/static_quality.py"
      ],
      "required_files": [
        "tools/static_quality.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "repository-hygiene",
      "command": [
        "python3",
        "tools/check_repo_hygiene.py"
      ],
      "required_files": [
        "tools/check_repo_hygiene.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "python-tests",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "required_files": [
        "tests"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "rust-format",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "required_files": [
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "rust-test",
      "command": [
        "cargo",
        "test",
        "--offline",
        "--locked"
      ],
      "required_files": [
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "rust-clippy",
      "command": [
        "cargo",
        "clippy",
        "--offline",
        "--locked",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "required_files": [
        "Cargo.toml",
        "Cargo.lock"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "distributable-build",
      "not_applicable": "No distributable build command exists in this repository validation contract; this does not claim release acceptance."
    },
    {
      "id": "lifecycle-mutations",
      "command": [
        "python3",
        "tools/check_lifecycle_mutations.py"
      ],
      "required_files": [
        "tools/check_lifecycle_mutations.py"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "durable-mutations",
      "command": [
        "python3",
        "tools/check_durable_mutations.py"
      ],
      "required_files": [
        "tools/check_durable_mutations.py"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "native-mutations",
      "command": [
        "python3",
        "tools/check_native_mutations.py"
      ],
      "required_files": [
        "tools/check_native_mutations.py"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "native-bridge-mutations",
      "command": [
        "python3",
        "tools/check_native_bridge_mutations.py"
      ],
      "required_files": [
        "tools/check_native_bridge_mutations.py"
      ],
      "timeout_seconds": 600
    }
  ],
  "lockfiles": [
    "requirements-quality.txt",
    "tools/quality-baseline.json",
    "Cargo.lock"
  ],
  "artifact_paths": [],
  "profiling": {
    "workloads": [
      {
        "id": "rust-offline-runtime-tests",
        "command": [
          "cargo",
          "test",
          "--offline",
          "--locked"
        ],
        "required_files": [
          "Cargo.toml",
          "Cargo.lock"
        ],
        "timeout_seconds": 600,
        "kind": "validation"
      }
    ]
  },
  "limitations": [
    "Profiling measures deterministic validation workloads, not native/provider performance.",
    "No evidence upload or retention policy is enabled.",
    "Native/live acceptance gates remain in their existing separate workflows.",
    "Raw child output is not included in sanitized verification reports."
  ]
}
