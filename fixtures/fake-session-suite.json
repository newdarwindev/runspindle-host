{
  "schema": "runspindle.host.fake-suite.v1",
  "seed": 0,
  "profiles": [
    "synthetic-macos",
    "synthetic-linux"
  ],
  "scenarios": [
    {
      "id": "H01",
      "test": "offline_unknown_stale_future_and_wrong_host_pins_queue_without_failover"
    },
    {
      "id": "H02",
      "test": "accepted_lost_reply_reconciles_once_without_second_launch"
    },
    {
      "id": "H03",
      "test": "absent_and_ambiguous_discovery_do_not_authorize_retry"
    },
    {
      "id": "H04",
      "test": "reconnect_preserves_observed_session_and_every_binding_field"
    },
    {
      "id": "H05",
      "test": "cancellation_ack_is_not_terminal_and_completion_race_keeps_actual_outcome"
    },
    {
      "id": "H06",
      "test": "cancel_before_start_forbids_launch_and_is_not_native_terminal"
    },
    {
      "id": "H07",
      "test": "cancel_lost_reply_does_not_retry_and_unknown_launch_remains_reconcilable"
    },
    {
      "id": "H08",
      "test": "queue_backpressure_precedes_effect_and_terminal_is_retryable_after_drain"
    },
    {
      "id": "H09",
      "test": "shutdown_forbids_dispatch_and_capabilities_stay_explicit"
    },
    {
      "id": "H10",
      "test": "every_lifecycle_receipt_keeps_exact_binding_and_rejects_canary_identity"
    },
    {
      "id": "H11",
      "test": "native::tests::native_frames_are_bounded_and_fail_closed"
    },
    {
      "id": "H12",
      "test": "native::tests::native_notification_backpressure_keeps_connection_unusable"
    },
    {
      "id": "H13",
      "test": "native::tests::native_owned_child_exit_is_observed_and_repeated_close_is_idempotent"
    },
    {
      "id": "H14",
      "test": "native_bridge_uncertain_start_never_relaunches_in_fresh_process_twice"
    },
    {
      "id": "H15",
      "test": "native_cancel_fresh_process_crash_never_repeats_interrupt"
    }
  ],
  "checks": [
    {
      "id": "format",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "rust",
      "command": [
        "cargo",
        "test",
        "--offline",
        "--locked"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "clippy",
      "command": [
        "cargo",
        "clippy",
        "--offline",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "scaffold",
      "command": [
        "python3",
        "tools/check_scaffold.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "python",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "lifecycle-mutations",
      "command": [
        "python3",
        "tools/check_lifecycle_mutations.py"
      ],
      "timeout_seconds": 300
    }
  ]
}
